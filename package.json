{
    "name": "@aeriondyseti/plugin-kit",
    "version": "2.2.0",
    "description": "Typed toolkit for Claude Code plugins: hook events, styled output, and shared widgets for mods via the plugin-kit plugin.",
    "type": "module",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/aeriondyseti/plugin-kit.git"
    },
    "homepage": "https://github.com/aeriondyseti/plugin-kit#readme",
    "bugs": {
        "url": "https://github.com/aeriondyseti/plugin-kit/issues"
    },
    "publishConfig": {
        "access": "public"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./testing": {
            "types": "./dist/testing.d.ts",
            "import": "./dist/testing.js"
        },
        "./widgets": {
            "types": "./dist/widgets.d.ts",
            "import": "./dist/widgets.js"
        },
        "./adapter": {
            "types": "./dist/adapter.d.ts",
            "import": "./dist/adapter.js"
        },
        "./statusline": {
            "types": "./dist/statusline.d.ts",
            "import": "./dist/statusline.js"
        }
    },
    "bin": {
        "plugin-kit": "dist/cli.js"
    },
    "files": [
        "dist",
        "src/widgets/hydrate.ts",
        "plugin/hooks/kit",
        "src/adapter/index.ts",
        "src/mod-testing/index.ts",
        "examples",
        "README.md",
        "CHANGELOG.md",
        "ROADMAP.md",
        "TECH-DEBT.md"
    ],
    "license": "MIT",
    "keywords": [
        "claude",
        "claude-code",
        "hook",
        "hooks",
        "cli",
        "anthropic",
        "plugin",
        "mod",
        "widgets"
    ],
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "build": "tsup",
        "typecheck": "tsc --noEmit && tsc -p tsconfig.contract.json",
        "plugin:sync": "node scripts/sync-plugin.mjs",
        "plugin:check": "claude plugin validate plugin && claude plugin test plugin",
        "docs:wiki": "node scripts/sync-wiki.mjs",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "dependencies": {
        "string-width": "^7.2.0"
    },
    "devDependencies": {
        "@types/node": "^20.14.0",
        "tsup": "^8.2.0",
        "typescript": "^5.6.0",
        "vitest": "^2.1.0"
    }
}
